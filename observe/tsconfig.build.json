{
  "extends": "../tsconfig.root.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "../../../",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "../../../src/**/*"],
  "exclude": ["node_modules", "dist"]
}