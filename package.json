{
  "name": "senars12",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "bin": {
    "senars": "./dist/cli/repl.js",
    "senars-mcp": "./dist/bin/mcp-server.js"
  },
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "repl": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/bin/repl.ts",
    "bot": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/bin/bot-ai.ts",
    "config:check": "tsx --env-file=.env src/utils/config-check.ts",
    "env:check": "NODE_NO_WARNINGS=1 tsx --env-file=.env -e \"import('./src/utils/env-validate.js').then(m => m.assertValidEnv())\"",
    "mcp": "NODE_NO_WARNINGS=1 tsx src/bin/mcp-server.ts",
    "pi": "bash scripts/pi-agent.sh",
    "pi:install": "npx pi install npm:pi-mcp-adapter",
    "test": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--experimental-vm-modules' pnpm exec jest --config jest.config.cjs",
    "test:unit": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--experimental-vm-modules' pnpm exec jest --config jest.unit.config.cjs",
    "test:integration": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--experimental-vm-modules' pnpm exec jest --config jest.config.cjs --testPathPattern=tests/integration --forceExit",
    "test:cognitive": "NODE_NO_WARNINGS=1 LM_PROVIDER=mock pnpm test:conversational",
    "test:cognitive:real": "NODE_NO_WARNINGS=1 pnpm test:conversational",
    "test:conversational": "NODE_NO_WARNINGS=1 tsx tests/conversational/runner.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.41",
    "@ai-sdk/provider": "^4.0.0",
    "@browser-ai/transformers-js": "2.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/blessed": "^0.1.27",
    "@types/react": "^19.2.14",
    "ai": "^7.0.2",
    "blessed": "^0.1.81",
    "cli-table3": "^0.6.5",
    "figures": "^6.1.0",
    "ink": "^7.0.3",
    "ink-text-input": "^6.0.0",
    "irc": "^0.5.2",
    "kleur": "^4.1.5",
    "ora": "^9.4.0",
    "react": "^19.2.6",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.9",
    "@types/irc": "^0.5.4",
    "@types/jest": "^29.5.14",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.19.19",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "fast-check": "^4.8.0",
    "jest": "^29.7.0",
    "peggy": "^5.1.0",
    "pi-mcp-adapter": "^2.10.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
