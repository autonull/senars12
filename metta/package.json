{
  "name": "@senars/metta",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./parser": {
      "types": "./src/parser/runtime.ts",
      "import": "./src/parser/runtime.ts"
    },
    "./engine": {
      "types": "./src/engine/egraph.ts",
      "import": "./src/engine/egraph.ts"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "import": "./src/agent/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@senars/core": "workspace:*",
    "effect": "^3.21.4",
    "immutable": "^5.1.9",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "fast-check": "^4.8.0",
    "tsx": "^4.21.0",
    "typescript": "7.0.1-rc",
    "vitest": "^4.1.9"
  }
}
