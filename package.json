{
  "name": "senars12",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "bin": {
    "senars": "./dist/cli/repl.js",
    "senars-mcp": "./dist/bin/mcp-server.js"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "tsx src/index.ts",
    "repl": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/bin/repl.ts",
    "bot": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/bin/bot-ai.ts",
    "multi-agent": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/bin/multi-agent.ts",
    "senars": "NODE_NO_WARNINGS=1 tsx src/bin/senars.ts",
    "tune": "tsx src/bin/tune.ts",
    "config:check": "tsx --env-file=.env src/utils/config-check.ts",
    "env:check": "NODE_NO_WARNINGS=1 tsx --env-file=.env -e \"import('./src/utils/env-validate.js').then(m => m.assertValidEnv())\"",
    "mcp": "NODE_NO_WARNINGS=1 tsx src/bin/mcp-server.ts",
    "mcptest": "NODE_NO_WARNINGS=1 tsx tests/mcp/integration-test.ts",
    "pi": "bash scripts/pi-agent.sh",
    "pi:install": "npx pi install npm:pi-mcp-adapter",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/e2e/** --exclude tests/benchmark/**",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e:smoke": "vitest run tests/e2e/agent-smoke.test.ts tests/e2e/metta-smoke.test.ts",
    "test:cognitive": "LM_PROVIDER=mock vitest run --dir tests/cognitive",
    "test:cognitive:real": "vitest run --dir tests/cognitive",
    "test:conversational": "NODE_NO_WARNINGS=1 tsx tests/conversational/runner.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "deps:check": "dpdm --circular --warning false src/ core/src/ nar/src/ io/src/ metta/src/",
    "exports:check": "tsx scripts/verify-exports.ts",
    "bench": "vitest run tests/nar/benchmark.test.ts tests/nar/benchmark-infra.test.ts",
    "typecheck": "tsc --noEmit",
    "self-tune-demo": "tsx scripts/self-tune-demo.ts",
    "web": "pnpm --dir ui dev",
    "build": "turbo run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@ai-sdk/provider": "^4.0.10",
    "@browser-ai/transformers-js": "3.0.2",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@senars/core": "workspace:*",
    "@senars/io": "workspace:*",
    "@senars/metta": "workspace:*",
    "@senars/nar": "workspace:*",
    "@senars/ui": "workspace:*",
    "@senars/util": "workspace:*",
    "@types/blessed": "^0.1.27",
    "@types/react": "^19.2.18",
    "ai": "^7.0.92",
    "blessed": "^0.1.81",
    "cli-table3": "^0.6.5",
    "dompurify": "^3.4.14",
    "figures": "^6.1.0",
    "highlight.js": "^11.12.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "irc": "^0.5.2",
    "kleur": "^4.1.5",
    "lit": "^3.3.3",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.4",
    "nanostores": "^1.5.3",
    "ora": "^9.4.1",
    "react": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "^4.5.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@js-temporal/polyfill": "^0.5.1",
    "@types/irc": "^0.5.4",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dpdm": "^4.3.0",
    "effect": "^3.22.1",
    "eslint": "^10.9.1",
    "fast-check": "^4.9.0",
    "immutable": "^5.1.9",
    "jest": "^30.5.1",
    "peggy": "^5.1.0",
    "pi-mcp-adapter": "^2.32.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "valibot": "^1.4.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0",
    "zod-fast-check": "^0.10.1"
  }
}
