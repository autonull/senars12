{
  "name": "senars12",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "bin": {
    "senars": "./dist/cli/repl.js",
    "senars-mcp": "./dist/bin/mcp-server.js"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "tsx src/index.ts",
    "repl": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/bin/repl.ts",
    "bot": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/bin/bot-ai.ts",
    "multi-agent": "NODE_NO_WARNINGS=1 tsx --env-file=.env src/bin/multi-agent.ts",
    "senars": "NODE_NO_WARNINGS=1 tsx src/bin/senars.ts",
    "config:check": "tsx --env-file=.env src/utils/config-check.ts",
    "env:check": "NODE_NO_WARNINGS=1 tsx --env-file=.env -e \"import('./src/utils/env-validate.js').then(m => m.assertValidEnv())\"",
    "mcp": "NODE_NO_WARNINGS=1 tsx src/bin/mcp-server.ts",
    "pi": "bash scripts/pi-agent.sh",
    "pi:install": "npx pi install npm:pi-mcp-adapter",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e:smoke": "vitest run tests/e2e/agent-smoke.test.ts tests/e2e/metta-smoke.test.ts",
    "test:cognitive": "LM_PROVIDER=mock vitest run --dir tests/cognitive",
    "test:cognitive:real": "vitest run --dir tests/cognitive",
    "test:conversational": "NODE_NO_WARNINGS=1 tsx tests/conversational/runner.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "deps:check": "dpdm --circular --warning false src/ core/src/ nar/src/ io/src/ metta/src/",
    "exports:check": "tsx scripts/verify-exports.ts",
    "bench": "vitest run tests/nar/benchmark.test.ts tests/nar/benchmark-infra.test.ts",
    "typecheck": "turbo run typecheck",
    "web": "pnpm --dir ui dev",
    "build": "turbo run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.41",
    "@ai-sdk/provider": "^4.0.0",
    "@browser-ai/transformers-js": "2.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@senars/core": "workspace:*",
    "@senars/io": "workspace:*",
    "@senars/metta": "workspace:*",
    "@senars/nar": "workspace:*",
    "@senars/ui": "workspace:*",
    "@senars/util": "workspace:*",
    "@types/blessed": "^0.1.27",
    "@types/react": "^19.2.14",
    "ai": "^7.0.31",
    "blessed": "^0.1.81",
    "cli-table3": "^0.6.5",
    "dompurify": "^3.4.11",
    "figures": "^6.1.0",
    "highlight.js": "^11.11.1",
    "ink": "^7.0.3",
    "ink-text-input": "^6.0.0",
    "irc": "^0.5.2",
    "kleur": "^4.1.5",
    "lit": "^3.3.3",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.4",
    "nanostores": "^1.3.0",
    "ora": "^9.4.0",
    "react": "^19.2.6",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@earendil-works/pi-coding-agent": "^0.79.9",
    "@js-temporal/polyfill": "^0.5.1",
    "@types/irc": "^0.5.4",
    "@types/jest": "^29.5.14",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.19.19",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "dpdm": "^3.14.0",
    "effect": "^3.0.0",
    "eslint": "^9.39.4",
    "fast-check": "^4.8.0",
    "immutable": "^5.0.0",
    "jest": "^29.7.0",
    "peggy": "^5.1.0",
    "pi-mcp-adapter": "^2.10.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "7.0.1-rc",
    "valibot": "^1.0.0",
    "vitest": "^4.1.9"
  }
}
