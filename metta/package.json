{
  "name": "@senars/metta",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./engine": {
      "types": "./src/engine/egraph.ts",
      "import": "./src/engine/egraph.ts"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "import": "./src/agent/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@senars/core": "workspace:*",
    "@senars/util": "workspace:*",
    "effect": "^4.1.4",
    "immutable": "^5.2.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
