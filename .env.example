# SeNARS12 Environment Configuration
# ================================
# Copy to .env and edit. Run `pnpm run config:check` to see resolved values.
# Unknown or mistyped vars are reported on startup (mistyped = hard-fail).

# --- Language Model ------------------------------------------------------
# LM_PROVIDER: transformers | openai-compatible | llamacpp | llamacpp-embedded | anthropic | openai | webllm | mock
# (openai-compatible covers any OpenAI-shaped server, incl. a local ollama daemon via LM_BASE_URL)
LM_PROVIDER=transformers
# LM_MODEL: model identifier (provider-specific)
LM_MODEL=Xenova/gpt-2

# --- Embedded llama.cpp (only used when LM_PROVIDER=llamacpp-embedded) ----
# LM_LLAMACPP_MODEL: path to GGUF model file (auto-resolved if omitted)
# LM_LLAMACPP_GPU_LAYERS: number of layers to offload to GPU (default: auto-fit via GgufInsights)
# LM_LLAMACPP_CTX: context window size (default: 4096)
# LM_LLAMACPP_BATCH: batch size (default: 512)
# LM_LLAMACPP_SEQS: parallel sequences (default: 1)
# LM_LLAMACPP_FLASH_ATTN: enable flash attention (default: true)

# --- Local OpenAI-compatible daemon (e.g. ollama) -------------------------
# LM_PROVIDER=openai-compatible + LM_BASE_URL=http://localhost:11434/v1
# ('LM_PROVIDER=ollama' still works as a deprecated alias for exactly this.)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Anthropic (only used when LM_PROVIDER=anthropic) ---------------------
ANTHROPIC_API_KEY=

# --- OpenAI / OpenAI-compatible (only used when LM_PROVIDER=openai|openai-compatible) ---
OPENAI_API_KEY=
LM_BASE_URL=
LM_API_KEY_ENV=

# --- Episodic Memory -----------------------------------------------------
EPISODIC_MEMORY_PATH=.cache/episodes
EPISODIC_RETENTION_DAYS=30

# --- Agent ---------------------------------------------------------------
AGENT_INSTRUCTIONS=
AUTO_TRIGGER_REASONING=false
REASONING_THRESHOLD=0.5
REASONING_COOLDOWN=3
MAX_REASONING_STEPS=5

# --- Connections (all default to disabled) -------------------------------
SENARS_AUTONOMY_BROADCAST=false

# CLI
SENARS_CLI_ENABLED=true

# IRC
SENARS_IRC_ENABLED=false
SENARS_IRC_SERVER=irc.libera.chat
SENARS_IRC_PORT=6667
SENARS_IRC_NICK=senars-bot
SENARS_IRC_CHANNELS=#senars
SENARS_IRC_AUTH_SECRET=

# WebSocket
SENARS_WS_ENABLED=false
SENARS_WS_PORT=8080

# HTTP
SENARS_HTTP_ENABLED=false
SENARS_HTTP_PORT=8081

# MCP
SENARS_MCP_ENABLED=false
SENARS_MCP_TRANSPORT=stdio

# --- Misc ----------------------------------------------------------------
SENARS_HISTFILE=/tmp/senars_history
SENARS_CONFIG=senars.config.json
DEBUG=
