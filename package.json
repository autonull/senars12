{
  "name": "senars12",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "bin": {
    "senars-mcp": "./dist/bin/mcp-server.js"
  },
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "repl": "NODE_NO_WARNINGS=1 tsx src/cli/repl.ts",
    "bot": "NODE_NO_WARNINGS=1 tsx src/bin/bot.ts",
    "mcp": "NODE_NO_WARNINGS=1 tsx src/bin/mcp-server.ts",
    "test": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--experimental-vm-modules' pnpm exec jest --config jest.config.cjs",
    "test:unit": "NODE_NO_WARNINGS=1 NODE_OPTIONS='--experimental-vm-modules' pnpm exec jest --config jest.unit.config.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.79",
    "@browser-ai/transformers-js": "1.0.0",
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^5.0.188",
    "cli-table3": "^0.6.5",
    "figures": "^6.1.0",
    "irc": "^0.5.2",
    "kleur": "^4.1.5",
    "ollama": "^0.6.3",
    "ollama-ai-provider-v2": "^3.5.1",
    "ora": "^9.4.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/irc": "^0.5.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.19",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "fast-check": "^4.8.0",
    "jest": "^29.7.0",
    "peggy": "^5.1.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
