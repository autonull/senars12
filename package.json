    "dev": "turbo run dev",
    "start": "tsx src/index.ts",
    "repl": "pnpm run senars run",
    "status": "pnpm run senars run -- --profile agent",
    "doctor": "pnpm run senars doctor check",
    "bot": "pnpm run senars run",
    "bot:irc": "ENABLE_IRC=true pnpm run senars run",
    "bot:ws": "ENABLE_WS=true pnpm run senars run",
    "bot:http": "ENABLE_HTTP=true pnpm run senars run",
    "bot:mcp": "ENABLE_MCP=true pnpm run senars run",
    "multi-agent": "pnpm run senars run -- --profile agent",
    "senars": "NODE_NO_WARNINGS=1 tsx --tsconfig tsconfig.root.json src/bin/senars.ts",
    "senars:edge": "pnpm run senars edge run",
    "senars:wasm-bundle": "pnpm run senars wasm-bundle",
    "logic": "pnpm run senars logic",
    "tune": "pnpm run senars doctor tune",
    "config:check": "pnpm run senars config validate",
    "config:validate": "pnpm run senars config validate",
    "config:generate": "tsx --tsconfig tsconfig.root.json scripts/config-generate.ts",
    "env:check": "NODE_NO_WARNINGS=1 tsx --env-file=.env -e \"import('./src/util/env-validate.js').then(m => m.assertValidEnv())\"",
    "mcp": "pnpm run senars serve mcp",
    "mcptest": "NODE_NO_WARNINGS=1 tsx tests/mcp/integration-test.ts",
    "pi": "bash scripts/pi-agent.sh",
    "pi:install": "pnpm dlx pi install npm:pi-mcp-adapter",
    "parity:smoke": "tsx --tsconfig tsconfig.root.json scripts/rl-parity.ts --env gridworld --baseline qlearning --mode both --seeds 1 --episodes 5 --steps 20",
    "test": "pnpm test:unit",
    "test:all": "vitest run",
    "test:unit": "vitest run --exclude 'tests/e2e/**' --exclude 'tests/benchmark/**' --exclude 'tests/nar/todo16-slo.test.ts' --exclude 'tests/nar/rl/parity-restoration.test.ts' --exclude 'tests/nar/rl/parity/bandit-epsilon-greedy.test.ts' --exclude 'tests/nar/todo17b-failclosed.test.ts' --exclude 'tests/nar/rl/budgetgate-verification.test.ts' --exclude 'tests/nar/todo26-cognitive-agent.test.ts' --exclude 'tests/nar/rl/parity/stress-boundary.test.ts' --exclude 'tests/nar/bag-fidelity.test.ts' --exclude 'tests/nar/todo16-groundedness-gate.test.ts' --exclude 'tests/nar/todo22-clm-wiring.test.ts' --exclude 'tests/nar/todo16c-rl-distill.test.ts' --exclude 'tests/nar/refactor4-budget.test.ts' --exclude 'tests/nar/refactor3-hygiene.test.ts' --exclude 'tests/nar/todo20-monoliths.test.ts' --exclude 'tests/demos/D1.test.ts' --exclude 'tests/kernel/terms.test.ts' --exclude 'tests/obligations/05-derivation-replay.test.ts' --exclude 'tests/logics/nal/truth.test.ts'",
    "test:load-sensitive": "VITEST_PARITY=1 vitest run --exclude 'tests/e2e/**' -t '@load-sensitive' tests/nar/todo16-slo.test.ts tests/nar/rl/parity-restoration.test.ts tests/nar/rl/parity/bandit-epsilon-greedy.test.ts tests/nar/rl/budgetgate-verification.test.ts tests/nar/todo17b-failclosed.test.ts tests/nar/todo26-cognitive-agent.test.ts tests/nar/rl/parity/stress-boundary.test.ts tests/nar/bag-fidelity.test.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e:smoke": "VITEST_E2E=1 vitest run tests/e2e/agent-smoke.test.ts tests/e2e/metta-smoke.test.ts",
    "test:e2e:bin": "LM_PROVIDER=llamacpp-embedded LM_LLAMACPP_MODEL=.models/Qwen3.5-0.8B-Q4_0.gguf LM_LLAMACPP_GPU=false VITEST_E2E=1 vitest run --pool=forks tests/e2e/bin-lifecycle.test.ts",
    "test:determinism": "VITEST_E2E=1 vitest run tests/e2e/determinism-gate.test.ts",
    "test:hermetic": "VITEST_E2E=1 vitest run tests/e2e/hermetic-run.test.ts",
    "test:cognitive": "LM_PROVIDER=mock vitest run --dir tests/cognitive",
    "test:cognitive:real": "vitest run --dir tests/cognitive",
    "test:conversational": "NODE_NO_WARNINGS=1 tsx --tsconfig tsconfig.root.json tests/conversational/runner.ts",
    "lint": "biome lint . --diagnostic-level=error",
    "lint:fix": "biome check --write .",
    "deps:check": "dpdm --circular --warning false src/ core/src/ nar/src/ io/src/ metta/src/",
