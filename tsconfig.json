{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "esnext.temporal", "dom", "dom.iterable"],
    "types": ["node", "vitest/globals"],
    "rootDir": ".",
    "paths": {
      "@senars/core": ["./core/src/index.ts"],
      "@senars/core/*": ["./core/src/*"],
      "@senars/io": ["./io/src/index.ts"],
      "@senars/io/*": ["./io/src/*"],
      "@senars/nar": ["./nar/src/index.ts"],
      "@senars/nar/*": ["./nar/src/*"],
      "@senars/metta": ["./metta/src/index.ts"],
      "@senars/metta/*": ["./metta/src/*"],
      "@senars/ui/*": ["./ui/src/*"],
      "@senars/kernel/*": ["./src/kernel/*"],
      "@senars/logics/*": ["./src/logics/*"],
      "@senars/verification/*": ["./src/verification/*"],
      "@senars/log/*": ["./src/log/*"],
      "@senars/formats/*": ["./src/formats/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests/setup", "src/cli/**", "src/bin/**", "src/api/**", "tests/obligations/**"]
}
