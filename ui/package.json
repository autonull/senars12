{
  "name": "@senars/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./server/*": {
      "types": "./src/server/*.ts",
      "import": "./src/server/*.ts"
    },
    "./unified-graph-projection": {
      "types": "./src/server/UnifiedGraphProjection.ts",
      "import": "./src/server/UnifiedGraphProjection.ts"
    },
    "./shared": {
      "types": "./src/shared/index.ts",
      "import": "./src/shared/index.ts"
    }
  },
  "scripts": {
    "build:tokens": "tsx scripts/build-tokens.ts",
    "prebuild": "pnpm build:tokens",
    "dev": "tsx src/server/index.ts",
    "dev:client": "vite dev --config vite.config.ts",
    "build:client": "vite build --config vite.config.ts",
    "build:client:test": "NODE_ENV=test vite build --mode test --config vite.config.ts",
    "build": "pnpm build:client",
    "start": "node dist/server/index.js",
    "start:test": "pnpm build:client:test && NODE_ENV=test tsx src/server/index.ts",
    "serve:test": "NODE_ENV=test tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build:client:test && playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "pnpm build:client:test && playwright test --config tests/playwright.config.ts --ui",
    "test:e2e:debug": "pnpm build:client:test && playwright test --config tests/playwright.config.ts --debug",
    "test:e2e:smoke": "pnpm build:client:test && playwright test tests/scenarios/smoke --config tests/playwright.config.ts",
    "test:e2e:critical": "pnpm build:client:test && playwright test --config tests/playwright.config.ts --grep @critical",
    "test:visual:update": "pnpm build:client:test && playwright test --config tests/playwright.config.ts --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "@senars/core": "workspace:*",
    "@senars/nar": "workspace:*",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.34.0",
    "dompurify": "^3.4.13",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "lit": "^3.3.3",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.4",
    "mime-types": "^3.0.2",
    "mitt": "^3.0.1",
    "nanoid": "^5.1.16",
    "onnxruntime-web": "^1.27.0",
    "three": "^0.160.1",
    "three-mesh-bvh": "^0.9.10",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/test": "8.6.14",
    "@storybook/web-components-vite": "8.6.14",
    "@types/jsdom": "^28.0.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.19.19",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "storybook": "10.5.6",
    "tsup": "^8.5.1",
    "typescript": "7.0.1-rc",
    "vite": "^8.2.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
