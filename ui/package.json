{
  "name": "@senars/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build:tokens": "tsx scripts/build-tokens.ts",
    "prebuild": "pnpm build:tokens",
    "dev:client": "vite dev --config vite.config.ts",
    "dev:server": "NODE_ENV=test tsx src/server/index.ts",
    "dev:test": "NODE_ENV=test concurrently -n server,client 'pnpm:dev:server' 'pnpm:dev:client'",
    "build:client": "vite build --config vite.config.ts",
    "build:client:test": "NODE_ENV=test vite build --mode test --config vite.config.ts",
    "dev": "concurrently -n server,client 'pnpm:dev:server' 'pnpm:dev:client'",
    "build": "pnpm build:client",
    "start": "node dist/server/index.js",
    "start:test": "pnpm build:client:test && NODE_ENV=test tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --config tests/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config tests/playwright.config.ts --debug",
    "test:e2e:smoke": "playwright test tests/scenarios/smoke --config tests/playwright.config.ts",
    "test:e2e:critical": "playwright test --config tests/playwright.config.ts --grep @critical",
    "test:visual:update": "playwright test --config tests/playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "cytoscape": "^3.30.0",
    "dompurify": "^3.2.0",
    "highlight.js": "^11.11.0",
    "lit": "^3.2.0",
    "marked": "^15.0.0",
    "marked-highlight": "^2.2.0",
    "mime-types": "^3.0.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.19.19",
    "@types/ws": "^8.5.10",
    "concurrently": "^9.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}
