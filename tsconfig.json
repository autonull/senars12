{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "esnext.temporal", "dom", "dom.iterable"],
    "types": ["node", "vitest/globals"],
    "rootDir": ".",
    "paths": {
      "@senars/core": ["./core/src/index.ts"],
      "@senars/core/*": ["./core/src/*"],
      "@senars/io": ["./io/src/index.ts"],
      "@senars/io/*": ["./io/src/*"],
      "@senars/nar": ["./nar/src/index.ts"],
      "@senars/nar/*": ["./nar/src/*"],
      "@senars/metta": ["./metta/src/index.ts"],
      "@senars/metta/*": ["./metta/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests/setup"]
}
