{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "disableReferencedProjectLoad": true
  },
  "files": [
    "src/index.ts",
    "src/schema.ts",
    "src/programs.ts",
    "src/run.ts",
    "src/record.ts",
    "src/checks.ts",
    "src/review.ts",
    "src/report.ts",
    "src/task.ts",
    "src/verify.ts",
    "src/diff.ts",
    "src/promote.ts",
    "src/cli.ts"
  ],
  "exclude": ["node_modules", "dist"]
}