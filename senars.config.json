{
  "name": "senars12",
  "version": "1.0.0",
  "configVersion": "1.0",
  "agent": {
    "name": "senars",
    "persona": "curious assistant"
  },
  "backends": {
    "nar": {
      "enabled": true,
      "cyclesPerStep": 10,
      "autonomy": {
        "enabled": true
      }
    }
  },
  "lm": {
    "provider": "transformers",
    "model": "onnx-community/Qwen2.5-1.5B-Instruct",
    "fastModel": "HuggingFaceTB/SmolLM2-360M-Instruct",
    "compactModel": "HuggingFaceTB/SmolLM2-360M-Instruct",
    "quantized": true,
    "cacheDir": ".cache/transformers"
  },
  "routing": {
    "objectives": {
      "chat": {
        "quality": "balanced",
        "maxLatencyMs": 2000
      },
      "rules": {
        "quality": "high",
        "offlineOnly": true
      },
      "structured": {
        "quality": "max"
      }
    },
    "candidates": [
      "cloud:quality",
      "cloud:fast",
      "cloud:structured",
      "builtin:quality",
      "builtin:fast",
      "builtin:compact"
    ],
    "offlineLadder": [
      "HuggingFaceTB/SmolLM2-135M-Instruct",
      "HuggingFaceTB/SmolLM2-360M-Instruct",
      "onnx-community/Qwen2.5-1.5B-Instruct",
      "onnx-community/Qwen2.5-3B-Instruct"
    ]
  },
  "memory": {
    "maxConcepts": 100,
    "bagSize": 50,
    "derivationDepth": 5
  },
  "inference": {
    "maxDerivationDepth": 10,
    "maxDerivationsPerStep": 100,
    "cpuThrottleMs": 10
  },
  "production": {
    "provider": "vercel",
    "model": "anthropic/claude-3.5-sonnet",
    "apiKeyEnv": "ANTHROPIC_API_KEY"
  },
  "irc": {
    "server": "irc.libera.chat",
    "port": 6697,
    "useTLS": true,
    "nick": "senars12",
    "channels": [
      "#nars"
    ]
  }
}
