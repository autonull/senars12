{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "paths": {
      "@senars/core": ["../../core/src/index.ts"],
      "@senars/core/*": ["../../core/src/*"],
      "@senars/io": ["../../io/src/index.ts"],
      "@senars/io/*": ["../../io/src/*"],
      "@senars/nar": ["../../nar/src/index.ts"],
      "@senars/nar/*": ["../../nar/src/*"],
      "@senars/metta": ["../../metta/src/index.ts"],
      "@senars/metta/*": ["../../metta/src/*"],
      "@senars/agent": ["../../src/agent/index.ts"],
      "@senars/agent/*": ["../../src/agent/*"],
      "@senars/budget": ["../../src/budget/index.ts"],
      "@senars/budget/*": ["../../src/budget/*"],
      "@senars/config": ["../../src/config/index.ts"],
      "@senars/config/*": ["../../src/config/*"],
      "@senars/health": ["../../src/health/index.ts"],
      "@senars/health/*": ["../../src/health/*"],
      "@senars/memory": ["../../src/memory/index.ts"],
      "@senars/memory/*": ["../../src/memory/*"],
      "@senars/terms": ["../../src/terms/index.ts"],
      "@senars/terms/*": ["../../src/terms/*"],
      "@senars/self": ["../../src/self/index.ts"],
      "@senars/self/*": ["../../src/self/*"],
      "@senars/rules": ["../../src/rules/index.ts"],
      "@senars/rules/*": ["../../src/rules/*"],
      "@senars/reflex": ["../../src/reflex/index.ts"],
      "@senars/reflex/*": ["../../src/reflex/*"],
      "@senars/nl": ["../../src/nl/index.ts"],
      "@senars/nl/*": ["../../src/nl/*"],
      "@senars/metrics": ["../../src/metrics/index.ts"],
      "@senars/metrics/*": ["../../src/metrics/*"],
      "@senars/query": ["../../src/query/index.ts"],
      "@senars/query/*": ["../../src/query/*"],
      "@senars/dialogue": ["../../src/dialogue/index.ts"],
      "@senars/dialogue/*": ["../../src/dialogue/*"],
      "@senars/otel": ["../../src/otel/index.ts"],
      "@senars/otel/*": ["../../src/otel/*"],
      "@senars/focus": ["../../src/focus/index.ts"],
      "@senars/focus/*": ["../../src/focus/*"],
      "@senars/utils": ["../../src/utils/index.ts"],
      "@senars/utils/*": ["../../src/utils/*"],
      "@senars/util": ["../../util/src/index.ts"],
      "@senars/util/*": ["../../util/src/*"],
      "@senars/kernel": ["../../src/kernel/index.ts"],
      "@senars/kernel/*": ["../../src/kernel/*"],
      "@senars/lm": ["../../src/lm/index.ts"],
      "@senars/lm/*": ["../../src/lm/*"],
      "@senars/transport": ["../../src/io/index.ts"],
      "@senars/transport/*": ["../../src/io/*"],
      "@senars/metta-runtime": ["../../src/metta/index.ts"],
      "@senars/metta-runtime/*": ["../../src/metta/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
